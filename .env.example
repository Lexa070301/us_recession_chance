# FRED API key — https://fred.stlouisfed.org/docs/api/api_key.html (free)
FRED_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of channel targets, format: locale:chat_id
# The bot must be an admin in each channel.
# Example: TG_CHANNELS=en:-1001234567890,ru:-1009876543210
TG_CHANNELS=

# SQLite database path
DATABASE_PATH=./data/recession.db

# App settings
TIMEZONE=UTC
LOG_LEVEL=info
