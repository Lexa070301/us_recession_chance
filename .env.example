# FRED API key — https://fred.stlouisfed.org/docs/api/api_key.html (free)
FRED_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram environment: "test" points the bot at the test DC (free Stars).
# Requires a SEPARATE bot created via @BotFather inside the test environment —
# its token goes into TELEGRAM_BOT_TOKEN for the test run.
TG_ENV=prod

# Dev only: override the Plus price in Stars for a production smoke test
# (minimum real price is 1 Star; refund yourself via /paysupport afterwards).
# STARS_PER_30D=1   (overrides the 30-day tier price; other tiers unchanged)

# Channel chat ids (bot must be admin). Names must match channels.yaml chat_id_env.
TG_CHANNEL_EN=
TG_CHANNEL_RU=

# SQLite database path
DATABASE_PATH=./data/recession.db

# Bot username without @ — enables the promo footer in channel posts (optional)
BOT_USERNAME=

# Admin Telegram user id — receives health-check alerts (optional)
ADMIN_TG_ID=

# App settings
# MODE=bot|scheduler|all (or pass as argv)
MODE=all
TIMEZONE=UTC
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Publishing environment (PLAN2): enable ONLY in GitHub Actions — the VPS
# scheduler must NOT set these, or channel posts / syndication double-post.
# ---------------------------------------------------------------------------

# Weekly PNG card as a photo before the text digest — fallback used only
# when SITE_URL is unset (with a site, the weekly post shows card.png as
# a large link preview instead)
# CARD_ENABLED=true

# External syndication master switch — enables the weekly self-audit
# and Telegraph pre-publication. Server must keep it unset.
# SYNDICATION_ENABLED=true
# Weekly self-audit to Telegram channels — independent of external
# syndication; set true when SYNDICATION_ENABLED is off but the digest
# environment should still post the audit. Server must keep it unset.
# SELF_AUDIT_ENABLED=true
# Comma-separated locales to syndicate (default: en — most external
# platforms are English-first; add ru deliberately)
# SYNDICATION_LOCALES=en,ru

# GitHub Pages URL — used for "read more" links and the /dashboard Mini App
# SITE_URL=https://<user>.github.io/<repo>

# Google Search Console verification token (the content value of the
# <meta name="google-site-verification"> tag) — emitted on the homepage.
# Set as a GitHub repo variable, not a local .env secret.
# GOOGLE_SITE_VERIFICATION=abc123...
# Yandex.Webmaster verification — same mechanism.
# YANDEX_VERIFICATION=abc123...

# Telegraph — one account per locale (tokens from telegra.ph API or
# https://telegra.ph/api — createAccount)
# TELEGRAPH_TOKEN_EN=
# TELEGRAPH_TOKEN_RU=

# Buffer (free tier: 3 channels) — multiplexes X / Threads / LinkedIn.
# Channel IDs from the Buffer dashboard; API key from buffer.com/developers.
# BUFFER_API_KEY=
# BUFFER_CHANNEL_X=
# BUFFER_CHANNEL_THREADS=
# BUFFER_CHANNEL_LINKEDIN=

# Bluesky — handle + app password (Settings → App Passwords)
# BSKY_HANDLE=your.name.bsky.social
# BSKY_APP_PASSWORD=

# Mastodon — instance origin + access token (Preferences → Development)
# MASTODON_INSTANCE=https://mastodon.social
# MASTODON_TOKEN=

# Discord — channel webhook URL (channel settings → Integrations)
# DISCORD_WEBHOOK_URL=

# Reddit — script-type app creds (reddit.com/prefs/apps); posts only to our
# OWN subreddit (weekly + self-audit — new subs rate-limit hard)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=
# REDDIT_SUBREDDIT=USRecessionWatch
